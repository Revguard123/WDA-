# Copy to .env.local and fill in. Never commit real secrets.
# SUPABASE_SERVICE_ROLE_KEY, SAM_API_KEY, ANTHROPIC_API_KEY, RESEND_API_KEY,
# TOKEN_SIGNING_SECRET, KAJABI_WEBHOOK_SECRET and CRON_SECRET are server-side
# only and must never reach the browser.

# Public base URL for all buyer-facing links (email buttons, setup/contracts/
# targeting pages). Local dev uses localhost; in Vercel production set this to
# the custom domain so every link is stable and brand-owned:
#   APP_BASE_URL=https://hq.wardogsacademy.com
APP_BASE_URL=http://localhost:3000

# From address for all outbound email. Must live on a domain verified in Resend.
# Defaults to "War Dogs Academy <contracts@wardogsacademy.com>" if unset.
EMAIL_FROM="War Dogs Academy <contracts@wardogsacademy.com>"

# Kajabi member library/products URL. When set, the contracts page shows a
# "Back to my products" link to it. Members keep their Kajabi session, so it
# opens without a re-login. Leave unset to hide the link.
# e.g. https://yoursite.mykajabi.com/library
KAJABI_LIBRARY_URL=

# Supabase (Project Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# SAM.gov (free public API key from your SAM.gov account > Account Details)
SAM_API_KEY=

# Anthropic (console.anthropic.com) . disqualification, why-line, deep-dive
ANTHROPIC_API_KEY=

# Resend (resend.com, after verifying a sending domain)
RESEND_API_KEY=

# Security
TOKEN_SIGNING_SECRET=
KAJABI_WEBHOOK_SECRET=
CRON_SECRET=

# Ops alerting. If a monthly batch errors, delivers a buyer zero contracts, or a
# cron run fails, an alert email goes here. Leave unset to disable alerting.
# ALERT_FROM is optional and defaults to EMAIL_FROM.
ALERT_EMAIL=
ALERT_FROM=

# Optional beta feedback Slack webhook. Server-side only. When set, the support
# modal can post "Send feedback" submissions directly into the WDA team Slack.
SLACK_CTC_FEEDBACK_WEBHOOK_URL=
