# Copy to .env.local and fill in. Never commit real secrets.
# SUPABASE_SERVICE_ROLE_KEY, SAM_API_KEY, ANTHROPIC_API_KEY, RESEND_API_KEY,
# TOKEN_SIGNING_SECRET, KAJABI_WEBHOOK_SECRET and CRON_SECRET are server-side
# only and must never reach the browser.

APP_BASE_URL=http://localhost:3000

# Supabase (Project Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# SAM.gov (free public API key from your SAM.gov account > Account Details)
SAM_API_KEY=

# Anthropic (console.anthropic.com) . disqualification, why-line, deep-dive
ANTHROPIC_API_KEY=

# Resend (resend.com, after verifying a sending domain)
RESEND_API_KEY=

# Security
TOKEN_SIGNING_SECRET=
KAJABI_WEBHOOK_SECRET=
CRON_SECRET=
